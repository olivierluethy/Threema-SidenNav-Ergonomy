{
  "manifest_version": 3,
  "name": "Threema Burger Menu Button",
  "version": "1.0",
  "description": "Ein Button, um das Layout auf web.threema.com zu steuern",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.threema.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://web.threema.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}